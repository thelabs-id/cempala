{
  "name": "cempala",
  "version": "0.5.0",
  "description": "A local MCP server that lets independent AI coding agents hand work to each other on the same machine.",
  "type": "module",
  "private": true,
  "bin": {
    "cempala": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "init": "bun run src/index.ts --init",
    "build": "bun build --compile src/index.ts --outfile dist/cempala",
    "build:all": "bash scripts/build-all.sh",
    "test": "bun test test/unit",
    "test:integration": "CEMPALA_INTEGRATION=1 bun test test/integration",
    "test:install": "bash scripts/test-install.sh",
    "test:uninstall": "bash scripts/test-uninstall.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
